<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Bella Beauty | Clínica de Estética</title>

<style>
:root{
    --rosa:#d63384;
    --rosa2:#f06fa5;
    --rosa-claro:#fde8f1;
    --rosa-hover:#b8236d;
    --verde:#198754;
    --azul:#0d6efd;
    --vermelho:#dc3545;
    --roxo:#6f42c1;
    --fundo:#fff8fb;
    --branco:#fff;
    --texto:#333;
    --cinza:#777;
    --borda:#eee;
    --sombra:0 8px 25px rgba(0,0,0,.08);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,Helvetica,sans-serif;
}

body{
    background:linear-gradient(135deg,#fff8fb,#f8f4f6);
    color:var(--texto);
    min-height:100vh;
}

/* HEADER */

header{
    background:linear-gradient(135deg,var(--rosa),var(--rosa2));
    color:white;
    text-align:center;
    padding:35px 20px;
    box-shadow:0 5px 20px rgba(214,51,132,.2);
}

header h1{
    font-size:32px;
    margin-bottom:8px;
}

header p{
    opacity:.95;
}

/* MENU */

nav{
    background:white;
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:8px;
    padding:12px;
    position:sticky;
    top:0;
    z-index:100;
    box-shadow:0 3px 12px rgba(0,0,0,.06);
}

nav button{
    border:none;
    background:transparent;
    color:var(--rosa);
    padding:10px 15px;
    border-radius:8px;
    cursor:pointer;
    font-weight:bold;
}

nav button:hover,
nav button.ativo{
    background:var(--rosa);
    color:white;
}

/* CONTAINER */

.container{
    width:92%;
    max-width:1200px;
    margin:30px auto;
}

/* SEÇÕES */

.secao{
    display:none;
}

.secao.ativa{
    display:block;
}

/* HERO */

.hero{
    background:
        linear-gradient(
            rgba(214,51,132,.82),
            rgba(240,111,165,.82)
        ),
        url("https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=1600&q=80");

    background-size:cover;
    background-position:center;

    color:white;
    padding:80px 30px;
    border-radius:20px;
    text-align:center;
    box-shadow:var(--sombra);
}

.hero h2{
    font-size:42px;
    margin-bottom:15px;
}

.hero p{
    max-width:700px;
    margin:auto;
    font-size:18px;
}

.hero button{
    margin-top:25px;
}

/* BOTÕES */

.btn{
    border:none;
    padding:12px 18px;
    border-radius:9px;
    cursor:pointer;
    font-weight:bold;
    transition:.2s;
}

.btn:hover{
    transform:translateY(-2px);
}

.btn-rosa{
    background:var(--rosa);
    color:white;
}

.btn-rosa:hover{
    background:var(--rosa-hover);
}

.btn-verde{
    background:var(--verde);
    color:white;
}

.btn-vermelho{
    background:var(--vermelho);
    color:white;
}

.btn-cinza{
    background:#eee;
    color:#555;
}

/* TITULOS */

.titulo{
    margin-bottom:20px;
}

.titulo h2{
    color:var(--rosa);
    margin-bottom:5px;
}

.titulo p{
    color:var(--cinza);
}

/* DASHBOARD */

.indicadores{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
    margin:25px 0;
}

.indicador{
    background:white;
    padding:22px;
    border-radius:15px;
    box-shadow:var(--sombra);
    border-left:5px solid var(--rosa);
}

.indicador span{
    display:block;
    color:var(--cinza);
    font-size:14px;
    margin-bottom:8px;
}

.indicador strong{
    font-size:30px;
}

.indicador.azul{
    border-color:var(--azul);
}

.indicador.verde{
    border-color:var(--verde);
}

.indicador.roxo{
    border-color:var(--roxo);
}

/* CARDS */

.cards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
    gap:20px;
}

.card{
    background:white;
    padding:25px;
    border-radius:16px;
    box-shadow:var(--sombra);
}

.card h3{
    color:var(--rosa);
    margin-bottom:10px;
}

.card p{
    color:var(--cinza);
    line-height:1.5;
}

/* PROCEDIMENTOS */

.procedimento{
    text-align:center;
}

.procedimento .icone{
    font-size:45px;
    margin-bottom:12px;
}

/* FORMULÁRIO */

.form-card{
    background:white;
    padding:25px;
    border-radius:16px;
    box-shadow:var(--sombra);
    max-width:850px;
    margin:auto;
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px;
}

.campo{
    display:flex;
    flex-direction:column;
    gap:7px;
}

.campo.full{
    grid-column:1/-1;
}

label{
    font-weight:bold;
    font-size:14px;
}

input,
select,
textarea{
    width:100%;
    padding:12px;
    border:1px solid var(--borda);
    border-radius:8px;
    outline:none;
    font-size:15px;
}

input:focus,
select:focus,
textarea:focus{
    border-color:var(--rosa);
    box-shadow:0 0 0 3px rgba(214,51,132,.1);
}

textarea{
    min-height:100px;
    resize:vertical;
}

.form-acoes{
    margin-top:20px;
    display:flex;
    gap:10px;
}

/* TABELA */

.tabela{
    background:white;
    padding:25px;
    border-radius:16px;
    box-shadow:var(--sombra);
}

.filtros{
    display:grid;
    grid-template-columns:2fr 1fr 1fr;
    gap:12px;
    margin-bottom:20px;
}

.tabela-container{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:850px;
}

th{
    background:var(--rosa);
    color:white;
    padding:13px;
}

td{
    padding:12px;
    text-align:center;
    border-bottom:1px solid #eee;
}

tr:hover{
    background:#fff7fa;
}

/* STATUS */

.status{
    display:inline-block;
    padding:6px 10px;
    border-radius:20px;
    font-size:12px;
    font-weight:bold;
}

.agendado{
    background:#dbeafe;
    color:#0756b5;
}

.confirmado{
    background:#d1e7dd;
    color:#0f5132;
}

.concluido{
    background:#ede3ff;
    color:#5b2a9d;
}

.cancelado{
    background:#f8d7da;
    color:#842029;
}

/* AÇÕES */

.acoes{
    display:flex;
    justify-content:center;
    gap:5px;
}

.acao{
    border:none;
    padding:7px 10px;
    border-radius:6px;
    color:white;
    cursor:pointer;
    font-size:12px;
    font-weight:bold;
}

.editar{
    background:var(--azul);
}

.excluir{
    background:var(--vermelho);
}

/* FOOTER */

footer{
    margin-top:40px;
    padding:25px;
    text-align:center;
    background:linear-gradient(135deg,var(--rosa),var(--rosa2));
    color:white;
}

/* RESPONSIVO */

@media(max-width:900px){

    .indicadores{
        grid-template-columns:1fr 1fr;
    }

    .filtros{
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:600px){

    header h1{
        font-size:24px;
    }

    nav{
        position:relative;
    }

    nav button{
        width:100%;
    }

    .hero{
        padding:55px 20px;
    }

    .hero h2{
        font-size:30px;
    }

    .indicadores{
        grid-template-columns:1fr;
    }

    .form-grid{
        grid-template-columns:1fr;
    }

    .campo.full{
        grid-column:auto;
    }

    .filtros{
        grid-template-columns:1fr;
    }

    .form-acoes{
        flex-direction:column;
    }

    .form-acoes button{
        width:100%;
    }
}
</style>
</head>

<body>

<header>
    <h1>✨ Bella Beauty</h1>
    <p>Clínica de Estética, Beleza & Bem-Estar</p>
</header>

<nav>
    <button class="ativo" onclick="mostrarSecao('inicio',this)">
        🏠 Início
    </button>

    <button onclick="mostrarSecao('clientes',this)">
        👩 Clientes
    </button>

    <button onclick="mostrarSecao('agendamento',this)">
        📅 Agendar
    </button>

    <button onclick="mostrarSecao('agenda',this)">
        📋 Agenda
    </button>

    <button onclick="mostrarSecao('procedimentos',this)">
        💆 Procedimentos
    </button>
</nav>

<main class="container">

<!-- INÍCIO -->

<section id="inicio" class="secao ativa">

    <div class="hero">

        <h2>Realce sua beleza ✨</h2>

        <p>
            Cuidados personalizados para sua pele,
            corpo e bem-estar em um ambiente acolhedor.
        </p>

        <button
            class="btn btn-rosa"
            style="background:white;color:#d63384"
            onclick="mostrarSecao('agendamento')"
        >
            📅 Agendar procedimento
        </button>

    </div>

    <div class="indicadores">

        <div class="indicador">
            <span>Clientes cadastradas</span>
            <strong id="totalClientes">0</strong>
        </div>

        <div class="indicador azul">
            <span>Total de agendamentos</span>
            <strong id="totalAgendamentos">0</strong>
        </div>

        <div class="indicador verde">
            <span>Confirmados</span>
            <strong id="totalConfirmados">0</strong>
        </div>

        <div class="indicador roxo">
            <span>Agendamentos hoje</span>
            <strong id="totalHoje">0</strong>
        </div>

    </div>

    <div class="titulo">
        <h2>🌸 Nossos destaques</h2>
        <p>Cuidados pensados para você.</p>
    </div>

    <div class="cards">

        <div class="card">
            <h3>✨ Beleza</h3>
            <p>
                Procedimentos estéticos personalizados
                para valorizar sua beleza natural.
            </p>
        </div>

        <div class="card">
            <h3>💗 Bem-estar</h3>
            <p>
                Momentos de relaxamento e cuidado
                para renovar corpo e mente.
            </p>
        </div>

        <div class="card">
            <h3>🌷 Atendimento</h3>
            <p>
                Atendimento acolhedor e experiência
                personalizada para cada cliente.
            </p>
        </div>

    </div>

</section>


<!-- CLIENTES -->

<section id="clientes" class="secao">

    <div class="titulo">
        <h2>👩 Cadastro de Clientes</h2>
        <p>Cadastre e gerencie suas clientes.</p>
    </div>

    <div class="form-card">

        <form id="formCliente">

            <div class="form-grid">

                <div class="campo">
                    <label>Nome completo *</label>
                    <input
                        type="text"
                        id="nomeCliente"
                        required
                        placeholder="Nome da cliente"
                    >
                </div>

                <div class="campo">
                    <label>Telefone *</label>
                    <input
                        type="tel"
                        id="telefoneCliente"
                        required
                        placeholder="(00) 00000-0000"
                    >
                </div>

                <div class="campo">
                    <label>E-mail</label>
                    <input
                        type="email"
                        id="emailCliente"
                        placeholder="cliente@email.com"
                    >
                </div>

                <div class="campo">
                    <label>Data de nascimento</label>
                    <input
                        type="date"
                        id="nascimentoCliente"
                    >
                </div>

            </div>

            <div class="form-acoes">

                <button class="btn btn-rosa" type="submit">
                    💾 Salvar Cliente
                </button>

                <button
                    class="btn btn-cinza"
                    type="reset"
                >
                    Limpar
                </button>

            </div>

        </form>

    </div>

    <br>

    <div class="tabela">

        <h2>Clientes cadastradas</h2>

        <div class="tabela-container">

            <table>

                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Telefone</th>
                        <th>E-mail</th>
                        <th>Ação</th>
                    </tr>
                </thead>

                <tbody id="listaClientes"></tbody>

            </table>

        </div>

    </div>

</section>


<!-- AGENDAMENTO -->

<section id="agendamento" class="secao">

    <div class="titulo">
        <h2>📅 Novo Agendamento</h2>
        <p>Preencha os dados para marcar um procedimento.</p>
    </div>

    <div class="form-card">

        <form id="formAgendamento">

            <div class="form-grid">

                <div class="campo">
                    <label>Cliente *</label>

                    <input
                        type="text"
                        id="clienteAgendamento"
                        required
                        placeholder="Nome da cliente"
                    >
                </div>

                <div class="campo">

                    <label>Procedimento *</label>

                    <select id="servicoAgendamento" required>

                        <option value="">
                            Selecione
                        </option>

                        <option>
                            Limpeza de Pele
                        </option>

                        <option>
                            Peeling Facial
                        </option>

                        <option>
                            Hidratação Facial
                        </option>

                        <option>
                            Drenagem Linfática
                        </option>

                        <option>
                            Massagem Relaxante
                        </option>

                        <option>
                            Design de Sobrancelhas
                        </option>

                        <option>
                            Depilação
                        </option>

                        <option>
                            Tratamento Corporal
                        </option>

                    </select>

                </div>

                <div class="campo">

                    <label>Data *</label>

                    <input
                        type="date"
                        id="dataAgendamento"
                        required
                    >

                </div>

                <div class="campo">

                    <label>Horário *</label>

                    <input
                        type="time"
                        id="horaAgendamento"
                        required
                    >

                </div>

                <div class="campo">

                    <label>Status</label>

                    <select id="statusAgendamento">

                        <option>Agendado</option>
                        <option>Confirmado</option>
                        <option>Concluído</option>
                        <option>Cancelado</option>

                    </select>

                </div>

                <div class="campo full">

                    <label>Observações</label>

                    <textarea
                        id="observacaoAgendamento"
                        placeholder="Observações sobre o atendimento..."
                    ></textarea>

                </div>

            </div>

            <div class="form-acoes">

                <button
                    type="submit"
                    class="btn btn-rosa"
                >
                    📅 Agendar
                </button>

                <button
                    type="reset"
                    class="btn btn-cinza"
                >
                    Limpar
                </button>

            </div>

        </form>

    </div>

</section>


<!-- AGENDA -->

<section id="agenda" class="secao">

    <div class="titulo">
        <h2>📋 Agenda da Clínica</h2>
        <p>Consulte e gerencie os agendamentos.</p>
    </div>

    <div class="tabela">

        <div class="filtros">

            <input
                type="search"
                id="pesquisaAgenda"
                placeholder="🔎 Cliente ou procedimento"
            >

            <input
                type="date"
                id="filtroData"
            >

            <select id="filtroStatus">

                <option value="">
                    Todos os status
                </option>

                <option>Agendado</option>
                <option>Confirmado</option>
                <option>Concluído</option>
                <option>Cancelado</option>

            </select>

        </div>

        <div class="tabela-container">

            <table>

                <thead>

                    <tr>
                        <th>Cliente</th>
                        <th>Procedimento</th>
                        <th>Data</th>
                        <th>Hora</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>

                </thead>

                <tbody id="listaAgenda"></tbody>

            </table>

        </div>

    </div>

</section>


<!-- PROCEDIMENTOS -->

<section id="procedimentos" class="secao">

    <div class="titulo">
        <h2>💆 Procedimentos</h2>
        <p>Conheça nossos principais serviços.</p>
    </div>

    <div class="cards">

        <div class="card procedimento">
            <div class="icone">✨</div>
            <h3>Limpeza de Pele</h3>
            <p>
                Higienização e cuidados para deixar
                a pele mais limpa e revitalizada.
            </p>
        </div>

        <div class="card procedimento">
            <div class="icone">🌸</div>
            <h3>Peeling Facial</h3>
            <p>
                Procedimento estético voltado
                à renovação da aparência da pele.
            </p>
        </div>

        <div class="card procedimento">
            <div class="icone">💆</div>
            <h3>Drenagem Linfática</h3>
            <p>
                Massagem corporal voltada ao
                relaxamento e bem-estar.
            </p>
        </div>

        <div class="card procedimento">
            <div class="icone">💗</div>
            <h3>Massagem Relaxante</h3>
            <p>
                Uma experiência para aliviar tensões
                e proporcionar relaxamento.
            </p>
        </div>

        <div class="card procedimento">
            <div class="icone">👁️</div>
            <h3>Sobrancelhas</h3>
            <p>
                Design personalizado para valorizar
                o formato natural do rosto.
            </p>
        </div>

        <div class="card procedimento">
            <div class="icone">🌷</div>
            <h3>Tratamento Corporal</h3>
            <p>
                Cuidados corporais personalizados
                conforme as necessidades da cliente.
            </p>
        </div>

    </div>

</section>

</main>

<footer>
    <p>✨ Bella Beauty — Clínica de Estética & Bem-Estar</p>
    <p>© 2026 Todos os direitos reservados.</p>
</footer>


<script>

/* =====================================================
   BANCO DE DADOS LOCAL
===================================================== */

let clientes =
    JSON.parse(
        localStorage.getItem("bella_clientes")
    ) || [];

let agendamentos =
    JSON.parse(
        localStorage.getItem("bella_agendamentos")
    ) || [];


/* =====================================================
   NAVEGAÇÃO
===================================================== */

function mostrarSecao(id, botao){

    document
        .querySelectorAll(".secao")
        .forEach(secao => {
            secao.classList.remove("ativa");
        });

    const secao =
        document.getElementById(id);

    if(secao){
        secao.classList.add("ativa");
    }

    document
        .querySelectorAll("nav button")
        .forEach(btn => {
            btn.classList.remove("ativo");
        });

    if(botao){
        botao.classList.add("ativo");
    }

    if(id === "clientes"){
        renderizarClientes();
    }

    if(id === "agenda"){
        renderizarAgenda();
    }

    atualizarDashboard();

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}


/* =====================================================
   SALVAR DADOS
===================================================== */

function salvarDados(){

    localStorage.setItem(
        "bella_clientes",
        JSON.stringify(clientes)
    );

    localStorage.setItem(
        "bella_agendamentos",
        JSON.stringify(agendamentos)
    );
}


/* =====================================================
   CLIENTES
===================================================== */

document
    .getElementById("formCliente")
    .addEventListener("submit", function(event){

        event.preventDefault();

        const cliente = {

            id:Date.now(),

            nome:
                document
                .getElementById("nomeCliente")
                .value
                .trim(),

            telefone:
                document
                .getElementById("telefoneCliente")
                .value
                .trim(),

            email:
                document
                .getElementById("emailCliente")
                .value
                .trim(),

            nascimento:
                document
                .getElementById("nascimentoCliente")
                .value

        };

        clientes.push(cliente);

        salvarDados();

        alert("Cliente cadastrada com sucesso! 💗");

        this.reset();

        renderizarClientes();

        atualizarDashboard();
    });


function renderizarClientes(){

    const lista =
        document.getElementById(
            "listaClientes"
        );

    lista.innerHTML = "";

    if(clientes.length === 0){

        lista.innerHTML = `
            <tr>
                <td colspan="4">
                    Nenhuma cliente cadastrada.
                </td>
            </tr>
        `;

        return;
    }

    clientes.forEach(cliente => {

        const tr =
            document.createElement("tr");

        tr.innerHTML = `

            <td>${escapar(cliente.nome)}</td>

            <td>${escapar(cliente.telefone)}</td>

            <td>${escapar(cliente.email || "-")}</td>

            <td>

                <button
                    class="acao excluir"
                    onclick="excluirCliente(${cliente.id})"
                >
                    🗑️ Excluir
                </button>

            </td>

        `;

        lista.appendChild(tr);
    });
}


function excluirCliente(id){

    const cliente =
        clientes.find(
            item => item.id === id
        );

    if(!cliente){
        return;
    }

    if(
        !confirm(
            `Excluir a cliente "${cliente.nome}"?`
        )
    ){
        return;
    }

    clientes =
        clientes.filter(
            item => item.id !== id
        );

    salvarDados();

    renderizarClientes();

    atualizarDashboard();
}


/* =====================================================
   AGENDAMENTOS
===================================================== */

document
    .getElementById("formAgendamento")
    .addEventListener("submit", function(event){

        event.preventDefault();

        const agendamento = {

            id:Date.now(),

            nome:
                document
                .getElementById(
                    "clienteAgendamento"
                )
                .value
                .trim(),

            servico:
                document
                .getElementById(
                    "servicoAgendamento"
                )
                .value,

            data:
                document
                .getElementById(
                    "dataAgendamento"
                )
                .value,

            hora:
                document
                .getElementById(
                    "horaAgendamento"
                )
                .value,

            status:
                document
                .getElementById(
                    "statusAgendamento"
                )
                .value,

            observacao:
                document
                .getElementById(
                    "observacaoAgendamento"
                )
                .value
                .trim()

        };

        agendamentos.push(
            agendamento
        );

        salvarDados();

        alert(
            "Agendamento realizado com sucesso! 📅"
        );

        this.reset();

        atualizarDashboard();
    });


/* =====================================================
   STATUS
===================================================== */

function classeStatus(status){

    if(status === "Confirmado"){
        return "confirmado";
    }

    if(status === "Concluído"){
        return "concluido";
    }

    if(status === "Cancelado"){
        return "cancelado";
    }

    return "agendado";
}


/* =====================================================
   FORMATAR DATA
===================================================== */

function formatarData(data){

    if(!data){
        return "-";
    }

    const partes =
        data.split("-");

    if(partes.length !== 3){
        return data;
    }

    return `
        ${partes[2]}/${partes[1]}/${partes[0]}
    `;
}


/* =====================================================
   AGENDA
===================================================== */

function renderizarAgenda(){

    const lista =
        document.getElementById(
            "listaAgenda"
        );

    const pesquisa =
        document
        .getElementById(
            "pesquisaAgenda"
        )
        .value
        .toLowerCase()
        .trim();

    const data =
        document.getElementById(
            "filtroData"
        ).value;

    const status =
        document.getElementById(
            "filtroStatus"
        ).value;


    let resultado =
        agendamentos.filter(item => {

            const nome =
                (item.nome || "")
                .toLowerCase();

            const servico =
                (item.servico || "")
                .toLowerCase();

            const correspondePesquisa =
                !pesquisa ||
                nome.includes(pesquisa) ||
                servico.includes(pesquisa);

            const correspondeData =
                !data ||
                item.data === data;

            const correspondeStatus =
                !status ||
                item.status === status;

            return (
                correspondePesquisa &&
                correspondeData &&
                correspondeStatus
            );
        });


    resultado.sort((a,b) => {

        const A =
            `${a.data} ${a.hora}`;

        const B =
            `${b.data} ${b.hora}`;

        return A.localeCompare(B);
    });


    lista.innerHTML = "";


    if(resultado.length === 0){

        lista.innerHTML = `
            <tr>
                <td colspan="6">
                    Nenhum agendamento encontrado.
                </td>
            </tr>
        `;

        return;
    }


    resultado.forEach(item => {

        const tr =
            document.createElement("tr");

        tr.innerHTML = `

            <td>
                ${escapar(item.nome)}
            </td>

            <td>
                ${escapar(item.servico)}
            </td>

            <td>
                ${formatarData(item.data)}
            </td>

            <td>
                ${escapar(item.hora || "-")}
            </td>

            <td>
                <span class="status ${classeStatus(item.status)}">
                    ${escapar(item.status)}
                </span>
            </td>

            <td>

                <div class="acoes">

                    <button
                        class="acao editar"
                        onclick="editarAgendamento(${item.id})"
                    >
                        ✏️
                    </button>

                    <button
                        class="acao excluir"
                        onclick="excluirAgendamento(${item.id})"
                    >
                        🗑️
                    </button>

                </div>

            </td>

        `;

        lista.appendChild(tr);

    });
}


/* =====================================================
   EDITAR AGENDAMENTO
===================================================== */

function editarAgendamento(id){

    const item =
        agendamentos.find(
            agendamento =>
                agendamento.id === id
        );

    if(!item){
        return;
    }

    const novoStatus =
        prompt(
            "Digite o novo status:\n\n" +
            "Agendado\n" +
            "Confirmado\n" +
            "Concluído\n" +
            "Cancelado",
            item.status
        );

    if(novoStatus === null){
        return;
    }

    const statusValidos = [
        "Agendado",
        "Confirmado",
        "Concluído",
        "Cancelado"
    ];

    if(
        !statusValidos.includes(
            novoStatus
        )
    ){

        alert(
            "Status inválido."
        );

        return;
    }

    item.status =
        novoStatus;

    salvarDados();

    renderizarAgenda();

    atualizarDashboard();
}


/* =====================================================
   EXCLUIR AGENDAMENTO
===================================================== */

function excluirAgendamento(id){

    const item =
        agendamentos.find(
            agendamento =>
                agendamento.id === id
        );

    if(!item){
        return;
    }

    if(
        !confirm(
            `Excluir o agendamento de "${item.nome}"?`
        )
    ){
        return;
    }

    agendamentos =
        agendamentos.filter(
            agendamento =>
                agendamento.id !== id
        );

    salvarDados();

    renderizarAgenda();

    atualizarDashboard();
}


/* =====================================================
   FILTROS
===================================================== */

document
    .getElementById("pesquisaAgenda")
    .addEventListener(
        "input",
        renderizarAgenda
    );

document
    .getElementById("filtroData")
    .addEventListener(
        "change",
        renderizarAgenda
    );

document
    .getElementById("filtroStatus")
    .addEventListener(
        "change",
        renderizarAgenda
    );


/* =====================================================
   DASHBOARD
===================================================== */

function atualizarDashboard(){

    document.getElementById(
        "totalClientes"
    ).textContent =
        clientes.length;


    document.getElementById(
        "totalAgendamentos"
    ).textContent =
        agendamentos.length;


    document.getElementById(
        "totalConfirmados"
    ).textContent =
        agendamentos.filter(
            item =>
                item.status === "Confirmado"
        ).length;


    const hoje =
        new Date()
        .toISOString()
        .split("T")[0];


    document.getElementById(
        "totalHoje"
    ).textContent =
        agendamentos.filter(
            item =>
                item.data === hoje
        ).length;
}


/* =====================================================
   PROTEÇÃO CONTRA HTML
===================================================== */

function escapar(valor){

    return String(valor || "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");
}


/* =====================================================
   DATA MÍNIMA DO AGENDAMENTO
===================================================== */

const campoData =
    document.getElementById(
        "dataAgendamento"
    );

const hoje =
    new Date();

const ano =
    hoje.getFullYear();

const mes =
    String(
        hoje.getMonth()+1
    ).padStart(2,"0");

const dia =
    String(
        hoje.getDate()
    ).padStart(2,"0");

campoData.min =
    `${ano}-${mes}-${dia}`;


/* =====================================================
   INICIAR
===================================================== */

atualizarDashboard();

renderizarClientes();

</script>

