// ============================================================
// DASHBOARD
// ============================================================

app.get(
    "/api/dashboard",
    (req, res) => {

        const resultado = {};


        db.get(
            `
                SELECT COUNT(*) AS total
                FROM clientes
            `,
            [],
            (erro, row) => {

                if (erro) {

                    return res.status(500).json({

                        error:
                            erro.message

                    });

                }


                resultado.clientes =
                    row.total;


                db.get(
                    `
                        SELECT COUNT(*) AS total
                        FROM agendamentos
                    `,
                    [],
                    (erro, row) => {

                        resultado.agendamentos =
                            row.total;


                        db.get(
                            `
                                SELECT COUNT(*) AS total

                                FROM agendamentos

                                WHERE status =
                                    'Confirmado'
                            `,
                            [],
                            (erro, row) => {

                                resultado.confirmados =
                                    row.total;


                                const hoje =
                                    new Date()
                                    .toISOString()
                                    .slice(0, 10);


                                db.get(

                                    `
                                        SELECT COUNT(*) AS total

                                        FROM agendamentos

                                        WHERE substr(
                                            data_hora,
                                            1,
                                            10
                                        ) = ?
                                    `,

                                    [hoje],

                                    (erro, row) => {

                                        resultado.hoje =
                                            row.total;


                                        res.json(
                                            resultado
                                        );

                                    }

                                );

                            }

                        );

                    }

                );

            }

        );

    }
);


