// ============================================================
// CLIENTES
// ============================================================

// SALVAR CLIENTE

app.post(
    "/api/clientes",
    (req, res) => {

        const {
            nome,
            cpf,
            telefone,
            email,
            nascimento,
            observacoes
        } = req.body;


        if (
            !nome ||
            !cpf ||
            !telefone
        ) {

            return res.status(400).json({

                success: false,

                message:
                    "Nome, CPF e telefone são obrigatórios."

            });

        }


        const sql = `

            INSERT INTO clientes
            (
                nome,
                cpf,
                telefone,
                email,
                nascimento,
                observacoes
            )

            VALUES (?, ?, ?, ?, ?, ?)

        `;


        db.run(
            sql,

            [
                nome.trim(),
                cpf.trim(),
                telefone.trim(),
                email || "",
                nascimento || "",
                observacoes || ""
            ],

            function (erro) {

                if (erro) {

                    if (
                        erro.message.includes(
                            "UNIQUE"
                        )
                    ) {

                        return res.status(409).json({

                            success: false,

                            message:
                                "Este CPF já está cadastrado."

                        });

                    }


                    return res.status(500).json({

                        success: false,

                        message:
                            erro.message

                    });

                }


                res.status(201).json({

                    success: true,

                    id: this.lastID,

                    message:
                        "Cliente cadastrado com sucesso."

                });

            }
        );

    }
);


// LISTAR CLIENTES

app.get(
    "/api/clientes",
    (req, res) => {

        db.all(
            `
                SELECT *

                FROM clientes

                ORDER BY nome ASC
            `,

            [],

            (erro, clientes) => {

                if (erro) {

                    return res.status(500).json({

                        error:
                            erro.message

                    });

                }


                res.json(clientes);

            }
        );

    }
);


// EXCLUIR CLIENTE

app.delete(
    "/api/clientes/:id",
    (req, res) => {

        const id =
            Number(req.params.id);


        db.run(
            `
                DELETE FROM clientes
                WHERE id = ?
            `,

            [id],

            function (erro) {

                if (erro) {

                    return res.status(500).json({

                        success: false,

                        message:
                            erro.message

                    });

                }


                res.json({

                    success:
                        this.changes > 0

                });

            }
        );

    }
);


// ============================================================
// SERVIÇOS
// ============================================================

// SALVAR SERVIÇO

app.post(
    "/api/servicos",
    (req, res) => {

        const {
            descricao,
            categoria,
            preco,
            tempo_estimado
        } = req.body;


        const valor =
            Number(preco);

        const tempo =
            Number(tempo_estimado);


        if (
            !descricao ||
            !categoria ||
            !Number.isFinite(valor) ||
            valor < 0 ||
            !Number.isInteger(tempo) ||
            tempo <= 0
        ) {

            return res.status(400).json({

                success: false,

                message:
                    "Dados do serviço inválidos."

            });

        }


        db.run(

            `
                INSERT INTO servicos
                (
                    descricao,
                    categoria,
                    preco,
                    tempo_estimado
                )

                VALUES (?, ?, ?, ?)
            `,

            [
                descricao.trim(),
                categoria,
                valor,
                tempo
            ],

            function (erro) {

                if (erro) {

                    return res.status(500).json({

                        success: false,

                        message:
                            erro.message

                    });

                }


                res.status(201).json({

                    success: true,

                    id: this.lastID

                });

            }

        );

    }
);


