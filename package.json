// ============================================================
// AGENDAMENTOS
// ============================================================

app.post(
    "/api/agendamentos",
    (req, res) => {

        const {
            cliente_id,
            data_hora,
            esteticista,
            observacoes,
            servicos
        } = req.body;


        if (
            !cliente_id ||
            !data_hora ||
            !esteticista
        ) {

            return res.status(400).json({

                success: false,

                message:
                    "Cliente, data/hora e esteticista são obrigatórios."

            });

        }


        if (
            !Array.isArray(servicos) ||
            servicos.length === 0
        ) {

            return res.status(400).json({

                success: false,

                message:
                    "Selecione pelo menos um procedimento."

            });

        }


        const clienteId =
            Number(cliente_id);


        // ----------------------------------------------------
        // BUSCAR SERVIÇOS
        // ----------------------------------------------------

        const ids =
            servicos.map(
                item =>
                    Number(item.id)
            );


        const placeholders =
            ids.map(() => "?").join(",");


        db.all(

            `
                SELECT
                    id,
                    descricao,
                    preco,
                    tempo_estimado

                FROM servicos

                WHERE ativo = 1
                AND id IN (${placeholders})
            `,

            ids,

            (erro, servicosBanco) => {

                if (erro) {

                    return res.status(500).json({

                        success: false,

                        message:
                            erro.message

                    });

                }


                if (
                    servicosBanco.length !==
                    ids.length
                ) {

                    return res.status(400).json({

                        success: false,

                        message:
                            "Um ou mais serviços não existem."

                    });

                }


                // ------------------------------------------------
                // CALCULAR TOTAL
                // ------------------------------------------------

                let total = 0;

                let tempoTotal = 0;


                servicosBanco.forEach(
                    servico => {

                        total +=
                            Number(
                                servico.preco
                            );

                        tempoTotal +=
                            Number(
                                servico.tempo_estimado
                            );

                    }
                );


                // ------------------------------------------------
                // TRANSAÇÃO
                // ------------------------------------------------

                db.serialize(() => {

                    db.run(
                        "BEGIN TRANSACTION"
                    );


                    db.run(

                        `
                            INSERT INTO agendamentos
                            (
                                cliente_id,
                                data_hora,
                                esteticista,
                                total,
                                tempo_total,
                                observacoes
                            )

                            VALUES (?, ?, ?, ?, ?, ?)
                        `,

                        [
                            clienteId,
                            data_hora,
                            esteticista,
                            total,
                            tempoTotal,
                            observacoes || ""
                        ],

                        function (erro) {

                            if (erro) {

                                db.run(
                                    "ROLLBACK"
                                );

                                return res.status(500).json({

                                    success: false,

                                    message:
                                        erro.message

                                });

                            }


                            const agendamentoId =
                                this.lastID;


                            const stmt =
                                db.prepare(`

                                    INSERT INTO
                                    itens_agendamento

                                    (
                                        agendamento_id,
                                        servico_id,
                                        preco_cobrado
                                    )

                                    VALUES (?, ?, ?)

                                `);


                            let erroItem = null;


                            servicosBanco.forEach(
                                servico => {

                                    stmt.run(

                                        [
                                            agendamentoId,
                                            servico.id,
                                            servico.preco
                                        ],

                                        erro => {

                                            if (
                                                erro &&
                                                !erroItem
                                            ) {

                                                erroItem =
                                                    erro;

                                            }

                                        }

                                    );

                                }
                            );


                            stmt.finalize(
                                () => {

                                    if (erroItem) {

                                        db.run(
                                            "ROLLBACK"
                                        );

                                        return res.status(500).json({

                                            success: false,

                                            message:
                                                erroItem.message

                                        });

                                    }


                                    db.run(
                                        "COMMIT"
                                    );


                                    res.status(201).json({

                                        success: true,

                                        id:
                                            agendamentoId,

                                        total,

                                        tempo_total:
                                            tempoTotal

                                    });

                                }
                            );

                        }

                    );

                });

            }

        );

    }
);


// ============================================================
// LISTAR AGENDAMENTOS
// ============================================================

app.get(
    "/api/agendamentos",
    (req, res) => {

        const sql = `

            SELECT

                a.id,

                a.data_hora,

                a.esteticista,

                a.total,

                a.tempo_total,

                a.status,

                a.observacoes,

                c.id AS cliente_id,

                c.nome AS cliente,

                c.telefone,

                c.cpf

            FROM agendamentos a

            INNER JOIN clientes c
                ON c.id = a.cliente_id

            ORDER BY
                a.data_hora ASC

        `;


        db.all(
            sql,
            [],
            (erro, rows) => {

                if (erro) {

                    return res.status(500).json({

                        error:
                            erro.message

                    });

                }


                res.json(rows);

            }
        );

    }
);


// ============================================================
// SERVIÇOS DE UM AGENDAMENTO
// ============================================================

app.get(
    "/api/agendamentos/:id/servicos",
    (req, res) => {

        const id =
            Number(req.params.id);


        db.all(

            `
                SELECT

                    i.id,

                    s.descricao,

                    s.categoria,

                    i.preco_cobrado

                FROM itens_agendamento i

                INNER JOIN servicos s
                    ON s.id = i.servico_id

                WHERE
                    i.agendamento_id = ?

                ORDER BY
                    s.descricao ASC
            `,

            [id],

            (erro, rows) => {

                if (erro) {

                    return res.status(500).json({

                        error:
                            erro.message

                    });

                }


                res.json(rows);

            }

        );

    }
);


// ============================================================
// ALTERAR STATUS
// ============================================================

app.patch(
    "/api/agendamentos/:id/status",
    (req, res) => {

        const id =
            Number(req.params.id);

        const {
            status
        } = req.body;


        const statusValidos = [

            "Agendado",

            "Confirmado",

            "Concluído",

            "Cancelado"

        ];


        if (
            !statusValidos.includes(
                status
            )
        ) {

            return res.status(400).json({

                success: false,

                message:
                    "Status inválido."

            });

        }


        db.run(

            `
                UPDATE agendamentos

                SET status = ?

                WHERE id = ?
            `,

            [
                status,
                id
            ],

            function (erro) {

                if (erro) {

                    return res.status(500).json({

                        success: false,

                        message:
                            erro.message

                    });

                }


                res.json({

                    success:
                        this.changes > 0

                });

            }

        );

    }
);


